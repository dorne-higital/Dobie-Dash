{
  "name": "dobie-dash",
  "version": "0.5.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "dev:lan": "nuxt dev --host 0.0.0.0",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "serve:lan": "node scripts/serve-lan.mjs",
    "phone": "DOBIE_DEV_TOOLS=1 nuxt generate && node scripts/serve-lan.mjs",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run generate",
    "postinstall": "nuxt prepare",
    "cap:sync": "nuxt generate && cap sync ios",
    "storekit": "node scripts/make-storekit.mjs",
    "icon": "node scripts/save-icon.mjs",
    "functions:build": "esbuild game/server.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=supabase/functions/_shared/game.js --log-level=warning",
    "functions:deploy": "npm run functions:build && npx supabase functions deploy submit-run --use-api && npx supabase functions deploy profile --use-api",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "8.3.0",
    "@capacitor-firebase/analytics": "8.6.0",
    "@capacitor-firebase/crashlytics": "8.6.0",
    "@capacitor-firebase/remote-config": "8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@pinia/nuxt": "^1.0.3",
    "@revenuecat/purchases-capacitor": "13.7.0",
    "@supabase/supabase-js": "2.119.2",
    "nuxt": "^4.6.4",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "puppeteer-core": "25.16.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
