{
  "name": "dobie-dash",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "dev:lan": "nuxt dev --host 0.0.0.0",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "serve:lan": "node scripts/serve-lan.mjs",
    "phone": "nuxt generate && node scripts/serve-lan.mjs",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run generate",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@pinia/nuxt": "^1.0.3",
    "nuxt": "^4.6.4",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
